APP_NAME=Framework
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://www.base.local
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=techpeek
DB_USERNAME=techpeek
DB_PASSWORD=
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
UPLOAD_DISK=public
UPLOAD_MAX_SIZE_KB=32768
QUEUE_CONNECTION=sync
CACHE_STORE=backend
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_UPLOAD_VISIBILITY=private

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=
R2_URL=
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=false
R2_UPLOAD_VISIBILITY=private

OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=
OSS_REGION=cn-hangzhou
OSS_BUCKET=
OSS_URL=
OSS_ENDPOINT=https://s3.oss-cn-hangzhou.aliyuncs.com
OSS_USE_PATH_STYLE_ENDPOINT=false
OSS_UPLOAD_VISIBILITY=private

GCS_ACCESS_KEY_ID=
GCS_SECRET_ACCESS_KEY=
GCS_REGION=auto
GCS_BUCKET=
GCS_URL=
GCS_ENDPOINT=https://storage.googleapis.com
GCS_USE_PATH_STYLE_ENDPOINT=true
GCS_UPLOAD_VISIBILITY=private

OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_USE_PATH_STYLE_ENDPOINT=false
OBJECT_STORAGE_UPLOAD_VISIBILITY=private

VITE_APP_NAME="${APP_NAME}"

BACKEND_DOMAIN=a.base.local
PARTNER_DOMAIN=p.base.local
FRONTEND_DOMAIN=www.base.local
SESSION_STORE=backend
SESSION_COOKIE=framework_backend_session
SESSION_SECURE_COOKIE=false
APP_TIMEZONE=Asia/Shanghai

# AI is disabled until a server-side API key is configured.
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_MODERATION_MODEL=omni-moderation-latest
AI_HTTP_TIMEOUT=90
AI_CONNECT_TIMEOUT=10
AI_IMAGE_TIMEOUT=180
AI_MAX_OUTPUT_TOKENS=16384

AI_QUEUE_CONNECTION=ai
AI_QUEUE_DRIVER=database
AI_QUEUE=ai
AI_TASK_TIMEOUT=240
AI_TASK_TTL=3600
AI_CACHE_STORE=

SETTINGS_CACHE_STORE=global

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
FACEBOOK_GRAPH_VERSION=v23.0
