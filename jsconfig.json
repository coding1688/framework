{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "resources/js/backend/*"
      ],
      "@styles/*": [
        "resources/css/backend/*"
      ]
    }
  },
  "include": [
    "resources/js/backend/**/*.js",
    "resources/js/backend/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "public/build",
    "vendor"
  ]
}
